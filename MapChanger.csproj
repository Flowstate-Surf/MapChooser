<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>MapChanger</RootNamespace>
    <AssemblyName>MapChanger</AssemblyName>
    <OutputPath>$(MSBuildThisFileDirectory)build/</OutputPath>
    <PublishDir>$(OutputPath)publish/MapChanger</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Public shared-interface contract (MapChanger.Contracts) - also ships HudKit.Shared (HudKit.Core's API) transitively. -->
    <ProjectReference Include="contracts\MapChanger.Contracts\MapChanger.Contracts.csproj" />
    <ProjectReference Include="..\..\swiftlys2plugs\cs2-hudkit-port\cs2-hudkit\HudKit\HudKit.Shared\HudKit.Shared.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="SwiftlyS2.CS2" Version="1.4.11-beta.7" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!-- The contracts project lives under the repo root - keep its sources (and its obj/bin
       generated files) out of THIS project's default globbing. -->
  <ItemGroup>
    <Compile Remove="contracts\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="contracts\**\*" />
    <None Remove="contracts\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="resources/gamedata/**/*;resources/templates/**/*;resources/translations/**/*;resources/layout/**/*;resources/styles/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Ship the contract DLL next to the plugin resources so consumer plugins can resolve it. -->
  <Target Name="CopyContractsToExports" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)MapChanger.Contracts.dll"
          DestinationFolder="$(OutputPath)resources/exports/"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutputPath)MapChanger.Contracts.dll')" />
  </Target>
  <Target Name="CopyContractsToPublishExports" AfterTargets="Publish">
    <Copy SourceFiles="$(OutputPath)MapChanger.Contracts.dll"
          DestinationFolder="$(PublishDir)resources/exports/"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutputPath)MapChanger.Contracts.dll')" />
  </Target>

  <Target Name="CreateZip" AfterTargets="Publish" Condition="'$(CreatePackageZip)' == 'true'">
    <ItemGroup>
      <PublishFiles Include="$(PublishDir)**\*.*" />
    </ItemGroup>
    <ZipDirectory SourceDirectory="$(PublishDir)../" DestinationFile="$(OutputPath)../$(AssemblyName).zip" Overwrite="true" />
  </Target>

</Project>