<root>
    <styles><include src="s2r://panorama/styles/custom_game/mapchooser/menu.vcss_c" /></styles>
    <Panel class="MapChooserWrapper">
        <Panel id="mapchooser-root" class="MapChooserRoot">
            <Panel class="MenuCard">
                <Label id="title" class="MenuTitle" text="{s:title}" />
                <Label class="MenuHint" text="{s:hint}" />
                <Panel class="MenuOptions">
                    <Button id="option_0" class="MenuOption">
                        <Label class="OptionNumber" text="{s:number_0}" hittest="false" />
                        <Label id="option_0_label" class="MapName" text="{s:option_0}" hittest="false" />
                        <Label id="tier_0" class="MapTag TierTag" text="{s:tier_0}" hittest="false" />
                        <Label id="bonus_0" class="MapTag" text="{s:bonus_0}" hittest="false" />
                        <Label id="type_0" class="MapTag" text="{s:type_0}" hittest="false" />
                    </Button>
                    <Button id="option_1" class="MenuOption">
                        <Label class="OptionNumber" text="{s:number_1}" hittest="false" />
                        <Label id="option_1_label" class="MapName" text="{s:option_1}" hittest="false" />
                        <Label id="tier_1" class="MapTag TierTag" text="{s:tier_1}" hittest="false" />
                        <Label id="bonus_1" class="MapTag" text="{s:bonus_1}" hittest="false" />
                        <Label id="type_1" class="MapTag" text="{s:type_1}" hittest="false" />
                    </Button>
                    <Button id="option_2" class="MenuOption">
                        <Label class="OptionNumber" text="{s:number_2}" hittest="false" />
                        <Label id="option_2_label" class="MapName" text="{s:option_2}" hittest="false" />
                        <Label id="tier_2" class="MapTag TierTag" text="{s:tier_2}" hittest="false" />
                        <Label id="bonus_2" class="MapTag" text="{s:bonus_2}" hittest="false" />
                        <Label id="type_2" class="MapTag" text="{s:type_2}" hittest="false" />
                    </Button>
                    <Button id="option_3" class="MenuOption">
                        <Label class="OptionNumber" text="{s:number_3}" hittest="false" />
                        <Label id="option_3_label" class="MapName" text="{s:option_3}" hittest="false" />
                        <Label id="tier_3" class="MapTag TierTag" text="{s:tier_3}" hittest="false" />
                        <Label id="bonus_3" class="MapTag" text="{s:bonus_3}" hittest="false" />
                        <Label id="type_3" class="MapTag" text="{s:type_3}" hittest="false" />
                    </Button>
                    <Button id="option_4" class="MenuOption">
                        <Label class="OptionNumber" text="{s:number_4}" hittest="false" />
                        <Label id="option_4_label" class="MapName" text="{s:option_4}" hittest="false" />
                        <Label id="tier_4" class="MapTag TierTag" text="{s:tier_4}" hittest="false" />
                        <Label id="bonus_4" class="MapTag" text="{s:bonus_4}" hittest="false" />
                        <Label id="type_4" class="MapTag" text="{s:type_4}" hittest="false" />
                    </Button>
                    <Button id="option_5" class="MenuOption">
                        <Label class="OptionNumber" text="{s:number_5}" hittest="false" />
                        <Label id="option_5_label" class="MapName" text="{s:option_5}" hittest="false" />
                        <Label id="tier_5" class="MapTag TierTag" text="{s:tier_5}" hittest="false" />
                        <Label id="bonus_5" class="MapTag" text="{s:bonus_5}" hittest="false" />
                        <Label id="type_5" class="MapTag" text="{s:type_5}" hittest="false" />
                    </Button>
                    <Button id="option_6" class="MenuOption">
                        <Label class="OptionNumber" text="{s:number_6}" hittest="false" />
                        <Label id="option_6_label" class="MapName" text="{s:option_6}" hittest="false" />
                        <Label id="tier_6" class="MapTag TierTag" text="{s:tier_6}" hittest="false" />
                        <Label id="bonus_6" class="MapTag" text="{s:bonus_6}" hittest="false" />
                        <Label id="type_6" class="MapTag" text="{s:type_6}" hittest="false" />
                    </Button>
                    <Button id="option_7" class="MenuOption">
                        <Label class="OptionNumber" text="{s:number_7}" hittest="false" />
                        <Label id="option_7_label" class="MapName" text="{s:option_7}" hittest="false" />
                        <Label id="tier_7" class="MapTag TierTag" text="{s:tier_7}" hittest="false" />
                        <Label id="bonus_7" class="MapTag" text="{s:bonus_7}" hittest="false" />
                        <Label id="type_7" class="MapTag" text="{s:type_7}" hittest="false" />
                    </Button>
                </Panel>
                <Button id="menu_close" class="MenuOption CloseOption"><Label class="MapName" text="{s:close_hint}" hittest="false" /></Button>
            </Panel>
        </Panel>
    </Panel>
</root>
